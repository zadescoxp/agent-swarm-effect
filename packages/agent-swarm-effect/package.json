{
  "name": "agent-swarm-effect",
  "version": "0.1.1",
  "description": "Wrap any element and watch a swarm of cursor agents draw its frame and type its text in. React component + framework-free core.",
  "keywords": [
    "react",
    "animation",
    "agents",
    "cursor",
    "typewriter",
    "reveal",
    "canvas",
    "ui",
    "swarm"
  ],
  "license": "MIT",
  "author": "Zade (https://zadescoxp.com)",
  "homepage": "https://zadescoxp.github.io/agent-swarm-effect/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zadescoxp/agent-swarm-effect.git",
    "directory": "packages/agent-swarm-effect"
  },
  "bugs": "https://github.com/zadescoxp/agent-swarm-effect/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
